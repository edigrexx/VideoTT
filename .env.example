# Generate independent random values: python3 scripts/setup_env.py
POSTGRES_PASSWORD=
POSTGRES_APP_PASSWORD=
POSTGRES_N8N_PASSWORD=
WORKER_API_KEY=
N8N_ENCRYPTION_KEY=

# Real production pipeline. Obtain keys and select an API model with web_search + structured outputs.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-5.6-luna
PEXELS_API_KEY=
STOCK_PROVIDER=pexels
TTS_PROVIDER=edge
TTS_VOICE=en-US-AriaNeural
ALLOW_TEST_MODE=false

# n8n: localhost via SSH tunnel by default. For Dokploy HTTPS see README.
N8N_VERSION=2.38.6
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_PUBLIC_URL=http://localhost:5678/
N8N_SECURE_COOKIE=false
N8N_PROXY_HOPS=1
TIMEZONE=Asia/Almaty
N8N_LOCAL_PORT=5678
WORKER_LOCAL_PORT=8000

# Optional custom PostgreSQL URL. Leave blank for the bundled database; passwords are URL-encoded in code.
DATABASE_URL=
# MEDIA_ROOT is fixed to /data/media inside Compose; local Python runs can override it.
MEDIA_ROOT=/data/media
MAX_ASSET_SIZE_MB=120
MIN_VIDEO_DURATION_SEC=60
MAX_VIDEO_DURATION_SEC=90
MAX_DOWNLOAD_RETRIES=3
MAX_JOB_ATTEMPTS=3
MAX_QUEUED_JOBS=20
FFMPEG_THREADS=2
FFMPEG_PRESET=veryfast
FFMPEG_TIMEOUT_SEC=900
HTTP_TIMEOUT_SEC=30
LLM_TIMEOUT_SEC=120
TTS_TIMEOUT_SEC=180
JOB_TIMEOUT_SEC=3600
MIN_FACT_CONFIDENCE=0.85
POLL_INTERVAL_SEC=3
